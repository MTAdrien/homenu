<div class="fridge-page">

  <header class="fridge-header">
    <div class="fridge-brand">
      <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                    alt: "HomeNu",
                    class: "fridge-logo" %>

      <span class="fridge-title">Fridge</span>
    </div>
  </header>

  <section class="fridge-section">
    <h1>Your Fridge</h1>

    <div class="fridge-items">
      <% @household.fridge_items.each do |item| %>
        <div class="fridge-item">

          <div class="fridge-item-info">
            <strong><%= item.name %></strong>
            <span>Quantity: <%= item.quantity %></span>
          </div>

          <div class="fridge-item-actions">
            <button class="fridge-quantity-btn">−</button>
            <span><%= item.quantity %></span>
            <button class="fridge-quantity-btn">+</button>

            <button class="fridge-delete-btn">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>

        </div>
      <% end %>
    </div>

    <%= link_to "Add item",
                new_household_fridge_item_path(@household),
                class: "btn btn-primary w-100" %>

    <button class="btn btn-outline-primary w-100">
      Ask AI what I can cook
    </button>
  </section>

</div>
