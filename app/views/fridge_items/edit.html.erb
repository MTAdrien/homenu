<div class="fridge-page">

  <header class="fridge-header">
    <div class="fridge-brand">
      <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                    alt: "HomeNu",
                    class: "fridge-logo" %>

      <span class="fridge-title">Fridge</span>
    </div>

    <div class="fridge-avatar">
      <%= image_tag current_user.avatar_url,
              alt: current_user.email,
              class: "settings-profile-avatar" %>
    </div>
  </header>

  <section class="fridge-new-intro">
    <h1>Edit item</h1>
    <p>Update this fridge item.</p>
  </section>

  <div class="fridge-form-card">

    <%= simple_form_for [@household, @fridge_item] do |f| %>

      <%= f.input :name,
                  label: "Item name" %>

      <%= f.input :quantity,
                  label: "Quantity",
                  input_html: { min: 1 } %>

      <%= f.button :submit,
                   "Update item",
                   class: "fridge-submit-btn" %>

    <% end %>

    <%= link_to "Cancel",
                household_fridge_items_path(@household),
                class: "fridge-cancel-btn" %>

  </div>

</div>
