<div class="household-page">

  <!-- HEADER -->
  <header class="household-header">
    <div class="household-brand">
      <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                    alt: "HomeNu",
                    class: "household-logo" %>

      <span class="household-title">Household</span>
    </div>

    <a href="/settings" class="settings-profile-link" aria-label="Paramètres">
      <div class="fa-solid fa-circle-user settings-profile"></div>
    </a>
  </header>


  <!-- HOUSEHOLD -->
  <section class="household-intro">
    <h1 class="household-name">
      <%= @household.name %>
    </h1>

    <p class="household-count">
      ♙ <%= pluralize(@household.members.count, "member") %>
    </p>
  </section>


  <!-- MEMBERS -->
  <section class="household-section">

    <p class="section-title">HOUSEHOLD</p>

    <div class="household-members-card">

      <div class="members-list">

        <% @household.members.each do |member| %>

          <div class="household-member">

            <span class="member-avatar" style="background: <%= avatar_color(member.first_name) %>">
              <%= member.first_name.to_s.first.to_s.upcase %>
            </span>

            <span class="member-name">
              <%= member.user.name %>
            </span>

          </div>

        <% end %>

      </div>

    </div>

  </section>


  <!-- QUICK ACTIONS -->
  <section class="household-section">

    <p class="section-title">QUICK ACTIONS</p>


    <!-- Suggest -->
    <div class="quick-action-card">

      <div class="quick-action-icon suggest">
        <i class="fa-solid fa-utensils"></i>
      </div>

      <div class="quick-action-suggest">
      <%= button_to "✦ Quick suggest",
              chats_path,
              method: :post,
              params: { auto_recipe: true },
              class: "fridge-ai-btn" %>
      </div>

      <div class="quick-action-arrow">
        ›
      </div>

        <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142268/suggest-meal.png",
              alt: "Meal suggestion",
              class: "quick-action-image" %>

    </div>


  </section>
  <section class="footer-section">
    <%= render "shared/navbar" %>
  </section>
</div>
