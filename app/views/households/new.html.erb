<div class="devise-container">
  <div class="devise-card">

    <div class="devise-header">
      <div class="devise-logo">
        <%= image_tag "homenu_logo.png", alt: "HomeNu Logo" %>
      </div>

      <h1>Create your household</h1>
      <p>Give your home a name.</p>
    </div>

    <%= simple_form_for @household do |f| %>
      <div class="form-inputs">
        <%= f.input :name %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Create household", class: "btn btn-primary w-100" %>
      </div>
    <% end %>

  </div>
</div>
