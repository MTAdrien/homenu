<div class="devise-container">
  <div class="devise-card">

    <div class="devise-header">
      <div class="devise-logo">
        <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png", alt: "HomeNu Logo" %>
      </div>

      <h1>Edit your household</h1>
      <p>Update your home's name.</p>
    </div>

    <%= simple_form_for @household do |f| %>
      <div class="form-inputs">
        <%= f.input :name %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Save changes", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>
</div>
