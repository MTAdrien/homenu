<div class="container mt-5 chats-index">
  <div class="chats-header">
    <div class="chats-brand">
        <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                      alt: "HomeNu",
                      class: "chats-logo" %>
      <h1>Household recipes</h1>
    </div>

        <div class="chats-avatar">
        <%= current_user.name.to_s.first.upcase %>
      </div>
  </div>

  <% if @chats.any? %>
    <%= button_to "New chat", chats_path, class: "btn btn-primary mb-4" %>
    <ul class="list-group">
      <% @chats.each do |chat| %>
        <li class="list-group-item d-flex justify-content-between align-items-center position-relative">
          <%= link_to chat.name, chat_path(chat), class: "stretched-link" %>
          <%= button_to "Supprimer", chat_path(chat), method: :delete, class: "btn btn-sm btn-outline-danger chats-delete-btn", data: { turbo_confirm: "Supprimer cette recette ?" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= button_to "You don't have any recipes. Start creating recipes", chats_path, class: "btn btn-primary" %>
  <% end %>
  <div class="nav">
    <%= render "shared/navbar" %>
  </div>
</div>
