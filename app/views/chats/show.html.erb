<div class="chat-page">

  <%= turbo_stream_from @chat %>

  <!-- HEADER -->
  <header class="chat-topbar">

    <div class="chat-brand">
      <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                    alt: "HomeNu",
                    class: "household-logo" %>

      <span>AI Assistant</span>
    </div>

    <a href="/settings" class="settings-profile-link" aria-label="Paramètres">
     <%= image_tag current_user.avatar_url,
              alt: current_user.email,
              class: "settings-profile-avatar" %>
    </a>

  </header>


  <!-- INTRO -->
  <section class="chat-intro">

    <h1>HomeNu AI</h1>

    <p>
      Cooking with what you already have.
    </p>

  </section>


  <!-- CONVERSATION -->
  <main class="chat-conversation" id="messages">

    <% @messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>

  </main>


  <!-- MESSAGE FORM -->
  <section class="chat-composer">

    <%= form_with model: @message,
                  url: chat_messages_path(@chat),
                  method: :post,
                  class: "input-group" do |f| %>

      <%= f.text_field :content,
            class: "form-control",
            placeholder: "Ask a follow-up..." %>

      <%= f.button type: "submit",
            class: "btn chat-send-button" do %>
        <i class="fa-solid fa-paper-plane"></i>
      <% end %>

    <% end %>

  </section>
  <section class="footer-section">
    <%= render "shared/navbar" %>
  </section>
</div>
