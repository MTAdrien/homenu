<div class="chat-page">

  <!-- HEADER -->
  <header class="chat-topbar">

    <div class="chat-brand">
      <%= image_tag "https://res.cloudinary.com/gewxhipj/image/upload/v1787142267/homenu_logo.png",
                    alt: "HomeNu",
                    class: "household-logo" %>

      <span>AI Assistant</span>
    </div>

    <div class="household-avatar">
      <%= current_user.name.to_s.first.upcase %>
    </div>

  </header>


  <!-- INTRO -->
  <section class="chat-intro">

    <h1>HomeNu AI</h1>

    <p>
      Cooking with what you already have.
    </p>

  </section>


  <!-- CONVERSATION -->
  <main class="chat-conversation">

    <% @messages.each do |message| %>

      <% if message.role == "user" %>

        <div class="chat-message-row-user">

          <div class="chat-message-user">
            <%= message.content %>
          </div>

          <span class="chat-time">
            <%= message.created_at.strftime("%H:%M") %>
          </span>

        </div>

      <% elsif message.role == "assistant" %>

        <div class="chat-assistant-row">

          <div class="chat-ai-icon">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </div>

          <div class="chat-assistant-content">

            <div class="chat-message-assistant">
              <%= message.content %>
            </div>

            <span class="chat-time">
              <%= message.created_at.strftime("%H:%M") %>
            </span>

          </div>

        </div>

      <% end %>

    <% end %>

  </main>


  <!-- MESSAGE FORM -->
  <section class="chat-composer">

  <%= form_with model: @message,
                url: chat_messages_path(@chat),
                method: :post,
                data: { turbo: false },
                class: "input-group" do |f| %>

    <%= f.text_field :content,
          class: "form-control",
          placeholder: "Ask a follow-up..." %>

    <%= f.button type: "submit",
          class: "btn chat-send-button" do %>
      <i class="fa-solid fa-paper-plane"></i>
    <% end %>

  <% end %>

</section>

</div>
